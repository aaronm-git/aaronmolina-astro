---
import { getEntry } from 'astro:content';

/**
 * Pull-quote/testimonial section rendering the `aaron-ai-workflow`
 * testimonial entry as a large stamped card. Renders nothing when the
 * entry is missing.
 */
interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;

const testimonial = await getEntry('testimonials', 'aaron-ai-workflow');
const quote = testimonial?.data.quote ?? '';
const highlight = testimonial?.data.highlight;
const highlightIndex = highlight ? quote.indexOf(highlight) : -1;
const hasHighlight = highlight !== undefined && highlightIndex !== -1;
const quoteBefore = hasHighlight ? quote.slice(0, highlightIndex) : quote;
const quoteAfter = hasHighlight ? quote.slice(highlightIndex + highlight.length) : '';
---

{
  testimonial && (
    <section class={`section-py ${className}`}>
      <div class="container">
        <figure class="border-ink bg-paper relative mx-auto max-w-[900px] rounded-md border-2 p-8 shadow-[8px_8px_0_var(--color-signal)] sm:p-10">
          <span class="font-display border-ink bg-signal shadow-hard-sm absolute -top-4 left-6 rounded-xs border-2 px-2 pt-1 text-2xl font-black">
            &ldquo;
          </span>
          <blockquote>
            <p class="font-display text-ink text-[clamp(19px,2.4vw,27px)] leading-snug font-black">
              {quoteBefore}
              {hasHighlight && <span class="bg-signal px-1">{highlight}</span>}
              {quoteAfter}
            </p>
          </blockquote>
          <figcaption class="border-concrete-2 mt-4 flex flex-wrap justify-between gap-3 border-t pt-3">
            <span class="text-ink text-sm font-bold">{testimonial.data.name}</span>
            {testimonial.data.role && <span class="text-graphite font-mono text-xs tracking-[0.12em] uppercase">{testimonial.data.role}</span>}
          </figcaption>
        </figure>
      </div>
    </section>
  )
}
