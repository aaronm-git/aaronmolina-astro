---
import { getSiteEntry } from '@/lib/site-content';

const navigation = await getSiteEntry('siteNavigation', 'navigation');

/**
 * Molecule rendering the pill-style navigation tabs across the Hire
 * sub-pages (Overview, React, Next.js, Headless CMS), highlighting whichever
 * tab matches the current page.
 */
interface Props {
  /** Current page pathname, used to determine which tab is marked active */
  currentPath: string;
  /** Additional CSS classes */
  class?: string;
}

const tabs = navigation.hireLinks;

const { currentPath, class: className = '' } = Astro.props;
---

<div class={`mb-12 flex flex-wrap justify-center gap-2 ${className}`}>
  {
    tabs.map(tab => {
      const isActive = currentPath === tab.href;
      return (
        <a
          href={tab.href}
          class={`border-ink rounded-sm border-2 px-4 py-2 font-mono text-xs font-bold tracking-wide uppercase ${
            isActive ? 'bg-signal text-ink shadow-hard-sm' : 'bg-paper text-ink hover:bg-concrete-2'
          }`}
        >
          {tab.tabLabel}
        </a>
      );
    })
  }
</div>
