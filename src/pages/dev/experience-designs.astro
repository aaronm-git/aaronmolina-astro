---
import { Image } from 'astro:assets';
import MainLayout from '@/layouts/main-layout.astro';
import HeatLogo from '@/images/experience-heat.svg';
import CorsairLogo from '@/images/experience-corsair.svg';
import DatLogo from '@/images/experience-das.svg';
import PagelyftLogo from '@/images/experience-pagelyft.svg';

/**
 * Throwaway comparison page for choosing an experience-card layout.
 * Delete once a direction is picked.
 */
const roles = [
  { logo: HeatLogo, org: 'Miami HEAT', title: 'Full-Stack Developer', loc: 'Miami, Florida', dates: 'Dec 2021 - Jun 2022', len: '6 months', ratio: '1:1',
    blurb: 'Migrated HEAT.com from Drupal to WordPress/EJS, refreshed site content, and integrated real-time game data APIs.',
    tech: ['WordPress', 'Drupal', 'JavaScript', 'REST APIs'] },
  { logo: CorsairLogo, org: 'CORSAIR Memory, Inc', title: 'Frontend Web Developer', loc: 'Miami, Florida', dates: 'Dec 2019 - Feb 2022', len: '2 years, 2 months', ratio: '4.2:1',
    blurb: 'Built marketing landing pages and email campaigns, collaborating with marketing and influencer teams.',
    tech: ['React.js', 'JavaScript', 'HTML5', 'CSS3'] },
  { logo: DatLogo, org: 'Dealer Automation Technologies', title: 'Senior Full-Stack Engineer', loc: 'Miami, Florida', dates: 'Jul 2022 - Dec 2022', len: '5 months', ratio: '11.9:1',
    blurb: 'Built a dealership CRM SaaS platform and deployed it across multiple locations using React and AWS.',
    tech: ['React.js', 'GraphQL', 'AWS'] },
  { logo: PagelyftLogo, org: 'PageLyft, LLC', title: 'Founder', loc: 'Miami, Florida', dates: 'Sep 2023 - Present', len: '2 years, 11 months', ratio: '1:1',
    blurb: 'Lead the vision and execution of modern composable sites focused on speed, scalability, and creativity.',
    tech: ['Astro', 'Next.js', 'Sanity.io'] },
];

const designs = [
  { id: 1, name: 'Logo Lane', note: 'Logo sits in a fixed-height band above the content. Every mark shares one baseline and one lane height, so aspect ratio stops affecting the card rhythm.' },
  { id: 2, name: 'Type First', note: 'Company name carries the identity in Archivo Black. The logo is knocked to solid ink and demoted to a small corner chip, so all marks read as one family.' },
  { id: 3, name: 'Ledger', note: 'No card. Tabular rows with a fixed mono date column and a rule between entries. Built for scanning many roles at once.' },
  { id: 4, name: 'Split Rail', note: 'Dark left rail holds the logo knocked out to pure white plus the dates. The rail normalizes every logo to one color and one column width.' },
];
---

<MainLayout title="Experience layout options" description="Internal comparison page">
  <section class="bg-concrete py-10">
    <div class="container">
      <p class="text-graphite font-mono text-xs font-bold tracking-[0.18em] uppercase">Internal preview</p>
      <h1 class="font-display text-ink mt-2 text-4xl uppercase">Experience layout options</h1>
      <p class="text-graphite mt-3 max-w-[70ch] text-sm">
        Same four roles in every design. Logos span 1:1 through 11.9:1 on purpose, since that spread is what breaks the current layout.
      </p>
    </div>
  </section>

  {
    designs.map(design => (
      <section class="border-ink border-t-2 py-12" class:list={[design.id % 2 === 0 ? 'bg-concrete-2' : 'bg-concrete']}>
        <div class="container">
          <div class="mb-8">
            <span class="border-ink bg-signal text-ink shadow-hard-sm inline-block border-2 px-3 py-1 font-mono text-xs font-bold tracking-wider uppercase">
              Design {design.id} — {design.name}
            </span>
            <p class="text-graphite mt-3 max-w-[70ch] text-sm">{design.note}</p>
          </div>

          {design.id === 1 && (
            <div class="space-y-5">
              {roles.map(r => (
                <article class="border-ink bg-paper shadow-hard rounded-md border-2">
                  <div class="border-ink bg-concrete-2 flex items-center justify-between gap-4 border-b-2 px-6 py-4">
                    <Image src={r.logo} alt={r.org} width={480} height={240} class="max-h-10 w-auto max-w-[14rem] object-contain object-left" />
                    <div class="text-right font-mono text-xs font-bold whitespace-nowrap">
                      <div class="text-ink">{r.dates}</div>
                      <div class="text-graphite">{r.len}</div>
                    </div>
                  </div>
                  <div class="p-6">
                    <h3 class="font-display text-ink text-xl uppercase">{r.title}</h3>
                    <p class="text-signal-deep font-bold">{r.org}</p>
                    <p class="text-graphite text-sm">{r.loc}</p>
                    <p class="text-ink mt-4 text-sm">{r.blurb}</p>
                    <div class="mt-4 flex flex-wrap gap-2">
                      {r.tech.map(t => <span class="border-ink bg-paper border-2 px-2 py-1 font-mono text-[10px] font-bold uppercase">{t}</span>)}
                    </div>
                  </div>
                </article>
              ))}
            </div>
          )}

          {design.id === 2 && (
            <div class="space-y-5">
              {roles.map(r => (
                <article class="border-ink bg-paper shadow-hard relative rounded-md border-2 p-6">
                  <Image src={r.logo} alt={r.org} width={480} height={240} class="absolute top-6 right-6 max-h-6 w-auto max-w-[8rem] object-contain object-right opacity-70 [filter:brightness(0)]" />
                  <p class="text-graphite font-mono text-xs font-bold tracking-[0.14em] uppercase">{r.dates} · {r.len}</p>
                  <h3 class="font-display text-ink mt-2 max-w-[24ch] text-2xl uppercase">{r.org}</h3>
                  <p class="text-signal-deep mt-1 font-bold">{r.title}</p>
                  <p class="text-graphite text-sm">{r.loc}</p>
                  <p class="text-ink mt-4 max-w-[70ch] text-sm">{r.blurb}</p>
                  <div class="mt-4 flex flex-wrap gap-2">
                    {r.tech.map(t => <span class="border-ink bg-concrete-2 border-2 px-2 py-1 font-mono text-[10px] font-bold uppercase">{t}</span>)}
                  </div>
                </article>
              ))}
            </div>
          )}

          {design.id === 3 && (
            <div class="border-ink bg-paper shadow-hard rounded-md border-2">
              {roles.map((r, i) => (
                <div class:list={['flex flex-col gap-4 p-5 md:flex-row md:items-center', i > 0 ? 'border-ink border-t-2' : '']}>
                  <div class="text-graphite w-full shrink-0 font-mono text-xs font-bold md:w-44">
                    <div class="text-ink">{r.dates}</div>
                    <div>{r.len}</div>
                  </div>
                  <div class="border-ink hidden self-stretch border-l-2 md:block" />
                  <div class="min-w-0 flex-1">
                    <h3 class="font-display text-ink text-lg uppercase">{r.title}</h3>
                    <p class="text-signal-deep text-sm font-bold">{r.org}</p>
                    <p class="text-ink mt-2 max-w-[70ch] text-sm">{r.blurb}</p>
                  </div>
                  <div class="flex w-full shrink-0 items-center md:w-40 md:justify-end">
                    <Image src={r.logo} alt={r.org} width={480} height={240} class="max-h-8 w-auto max-w-full object-contain [filter:brightness(0)]" />
                  </div>
                </div>
              ))}
            </div>
          )}

          {design.id === 4 && (
            <div class="space-y-5">
              {roles.map(r => (
                <article class="border-ink bg-paper shadow-hard flex flex-col overflow-hidden rounded-md border-2 md:flex-row">
                  <div class="bg-ink flex w-full shrink-0 flex-col justify-between gap-4 p-5 md:w-56">
                    <Image src={r.logo} alt={r.org} width={480} height={240} class="max-h-12 w-auto max-w-full object-contain object-left [filter:brightness(0)_invert(1)]" />
                    <div class="font-mono text-xs font-bold">
                      <div class="text-signal">{r.dates}</div>
                      <div class="text-steel">{r.len}</div>
                    </div>
                  </div>
                  <div class="min-w-0 flex-1 p-6">
                    <h3 class="font-display text-ink text-xl uppercase">{r.title}</h3>
                    <p class="text-signal-deep font-bold">{r.org}</p>
                    <p class="text-graphite text-sm">{r.loc}</p>
                    <p class="text-ink mt-4 text-sm">{r.blurb}</p>
                    <div class="mt-4 flex flex-wrap gap-2">
                      {r.tech.map(t => <span class="border-ink bg-concrete-2 border-2 px-2 py-1 font-mono text-[10px] font-bold uppercase">{t}</span>)}
                    </div>
                  </div>
                </article>
              ))}
            </div>
          )}
        </div>
      </section>
    ))
  }
</MainLayout>
