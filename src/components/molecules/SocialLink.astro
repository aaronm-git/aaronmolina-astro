---
import { getBrandIcon } from '@/lib/icons';

type Tone = 'dark' | 'light';

/**
 * Social platform link rendered as an icon-only anchor.
 *
 * Brand marks come from official SVGs in `public/brands`. Platforms whose
 * artwork has not been sourced yet fall back to the Font Awesome brand glyph
 * so the link still renders; drop the official SVG into `public/brands` and
 * register it in the icon module to replace the fallback.
 */
interface Props {
  /** Platform key, e.g. `'github'`, `'linkedin'` */
  platform: string;
  /** Destination URL */
  url: string;
  /** Accessible label; falls back to `label`, then `platform` */
  ariaLabel?: string;
  /** Human-readable platform label */
  label?: string;
  /** Surface the link sits on, which drives hover color */
  tone?: Tone;
  /** Additional CSS classes */
  class?: string;
}

const { platform, url, ariaLabel, label, tone = 'dark', class: className = '' } = Astro.props;

const brandMark = getBrandIcon(platform);

const fallbackGlyphs: Record<string, string> = {
  linkedin: 'fa-brands fa-linkedin-in',
  instagram: 'fa-brands fa-instagram',
  facebook: 'fa-brands fa-facebook-f',
};
const fallbackGlyph = fallbackGlyphs[platform] ?? null;

const colorClasses = tone === 'dark' ? 'text-steel hover:text-signal' : 'text-graphite hover:text-ink';
---

{
  (brandMark || fallbackGlyph) && (
    <a
      href={url}
      target="_blank"
      rel="noopener noreferrer"
      class={`inline-flex items-center justify-center rounded-xs p-2 transition-colors ${colorClasses} ${className}`}
      aria-label={ariaLabel || label || platform}
    >
      {brandMark ? <img src={brandMark} alt="" width="20" height="20" class="h-5 w-5 object-contain" loading="lazy" /> : <i class={`${fallbackGlyph} text-xl`} aria-hidden="true" />}
    </a>
  )
}
