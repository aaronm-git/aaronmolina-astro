---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Badge from '@/components/atoms/Badge.astro';

interface Company {
  /** Company name */
  name: string;
  /** Alt text for the company's logo image */
  alt: string;
  /** Logo image asset */
  logo: ImageMetadata;
}

/**
 * Trust strip shown near the top of a page. Client wordmarks sit directly on
 * the section background rather than inside cards, so the marks themselves
 * carry the section. Each logo gets a uniform optical height instead of a
 * uniform box, which keeps wide wordmarks and squarer badges reading at the
 * same visual weight.
 */
interface Props {
  /** Small label above the logo row */
  eyebrow?: string;
  /** Guarantee statement shown below the logos */
  guaranteeText: string;
  /** Small badge labels rendered next to the guarantee text */
  badges: string[];
  /** Company logos to render */
  companies: Company[];
  class?: string;
}

const { eyebrow = 'Trusted by leading brands', guaranteeText, badges, companies, class: className = '' } = Astro.props;

// Wordmark lockups are wide; team badges are roughly square. Sizing every mark
// to one height makes the badges read as half the weight of the wordmarks, so
// each logo is scaled by its own aspect ratio instead.
const BADGE_MAX_RATIO = 1.6;

const sizedCompanies = companies.map(company => {
  const isBadge = company.logo.width / company.logo.height < BADGE_MAX_RATIO;
  return {
    ...company,
    sizeClass: isBadge ? 'h-20 w-auto sm:h-24' : 'h-10 w-auto max-w-[11rem] sm:h-12 sm:max-w-[13rem] lg:max-w-[15rem]',
  };
});
---

<section class={`border-ink bg-concrete-2 border-b-2 py-10 sm:py-12 ${className}`}>
  <div class="container">
    <p class="text-graphite text-center font-mono text-xs font-bold tracking-[0.18em] uppercase">{eyebrow}</p>

    <ul class="mt-8 flex flex-wrap items-center justify-center gap-x-12 gap-y-10 sm:gap-x-16 lg:gap-x-20">
      {
        sizedCompanies.map(company => (
          <li class="flex items-center justify-center">
            <Image src={company.logo} alt={company.alt} width={480} height={240} class={`${company.sizeClass} object-contain`} loading="lazy" />
          </li>
        ))
      }
    </ul>

    <div class="border-ink/15 mt-10 flex flex-wrap items-center justify-between gap-4 border-t-2 pt-6">
      <p class="text-ink flex max-w-[46ch] items-center gap-3 text-sm font-bold">
        <span class="border-ink bg-signal shadow-hard-sm flex h-10 w-10 flex-none items-center justify-center rounded-full border-2">
          <i class="fa-solid fa-check text-ink text-sm" aria-hidden="true"></i>
        </span>
        <span>{guaranteeText}</span>
      </p>
      <div class="flex flex-wrap gap-2">
        {badges.map(badge => <Badge label={badge} variant="default" size="sm" />)}
      </div>
    </div>
  </div>
</section>
