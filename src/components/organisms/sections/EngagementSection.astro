---
import SectionHeader from '@/components/molecules/SectionHeader.astro';
import Button from '@/components/atoms/Button.astro';
import ListItem from '@/components/molecules/ListItem.astro';
import type { CollectionEntry } from 'astro:content';

type Plan = CollectionEntry<'siteHire'>['data']['main']['engagement']['plans'][number];

/**
 * Engagement models / pricing tiers section - a row of plan cards plus a
 * dashed-border "custom" callout with a note and link. Composes
 * SectionHeader, ListItem, and Button.
 */
interface Props {
  /** Small label shown above the title */
  eyebrow?: string;
  /** Section title */
  title: string;
  /** Optional supporting copy below the title */
  description?: string;
  /** Engagement plan cards to render */
  plans: Plan[];
  /** Note text shown in the custom-engagement callout below the plans */
  customNote: string;
  /** Link rendered in the custom-engagement callout */
  customCta: { label: string; href: string };
  class?: string;
}

const { eyebrow, title, description, plans, customNote, customCta, class: className = '' } = Astro.props;
---

<section class={`section-py ${className}`}>
  <div class="container">
    <SectionHeader eyebrow={eyebrow} title={title} description={description} class="mb-10" />

    <div class="grid grid-cols-1 items-stretch gap-6 lg:grid-cols-3">
      {
        plans.map(plan => (
          <article class={`border-ink flex flex-col overflow-hidden rounded-md border-2 ${plan.highlighted ? 'shadow-[8px_8px_0_var(--color-signal-deep)]' : 'shadow-hard'}`}>
            <div class={`border-ink border-b-2 p-6 ${plan.highlighted ? 'bg-ink text-concrete' : 'bg-concrete-2 text-ink'}`}>
              <span class={`mb-2 block font-mono text-xs font-bold tracking-[0.16em] uppercase ${plan.highlighted ? 'text-signal' : 'text-graphite'}`}>{plan.eyebrow}</span>
              <h3 class="font-display text-2xl font-black uppercase">{plan.name}</h3>
            </div>
            <div class="bg-paper flex flex-1 flex-col gap-4 p-6">
              <p class="text-graphite text-sm">{plan.description}</p>
              <ul class="space-y-2">
                {plan.features.map(feature => (
                  <ListItem icon="check">{feature}</ListItem>
                ))}
              </ul>
              <div class="mt-auto pt-2 text-center">
                <Button href={plan.cta.href} variant={plan.highlighted ? 'primary' : 'ghost-ink'} size="sm" fullWidth>
                  {plan.cta.label}
                </Button>
              </div>
            </div>
          </article>
        ))
      }
    </div>

    <div class="border-ink bg-concrete-2 mt-6 flex flex-wrap items-center justify-between gap-4 rounded-md border-2 border-dashed p-6">
      <p class="text-ink max-w-[60ch] text-sm font-bold">{customNote}</p>
      <Button href={customCta.href} variant="ghost-ink" size="sm">{customCta.label}</Button>
    </div>
  </div>
</section>
