---
/**
 * Icon atom. Renders a Font Awesome glyph from a class string, scaled with the
 * type scale and tinted with design system color tokens. Font Awesome sizes by
 * font-size rather than box dimensions, so the size scale maps to text sizes.
 */
interface Props {
  /** Font Awesome class string, e.g. `fa-solid fa-house` */
  icon: string;
  /** Size in the type scale */
  size?: 'xs' | 'sm' | 'base' | 'lg' | 'xl';
  /** Token color to apply */
  color?: 'ink' | 'graphite' | 'steel' | 'signal' | 'signal-deep';
  /** Additional CSS classes */
  class?: string;
}

const { icon, size = 'base', color = 'ink', class: className = '' } = Astro.props;

const sizeClasses: Record<'xs' | 'sm' | 'base' | 'lg' | 'xl', string> = {
  xs: 'text-xs',
  sm: 'text-sm',
  base: 'text-base',
  lg: 'text-2xl',
  xl: 'text-4xl',
};

const colorClasses: Record<'ink' | 'graphite' | 'steel' | 'signal' | 'signal-deep', string> = {
  ink: 'text-ink',
  graphite: 'text-graphite',
  steel: 'text-steel',
  signal: 'text-signal',
  'signal-deep': 'text-signal-deep',
};
---

<i class={`${icon} ${sizeClasses[size]} ${colorClasses[color]} ${className}`} aria-hidden="true"></i>
